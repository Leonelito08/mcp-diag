# Copiar a /opt/mcp-diag/.env y completar.
# Este archivo contiene la credencial de acceso: chmod 600, dueño mcpdiag.

# Generar con: openssl rand -hex 32   (mínimo 32 caracteres, es LA credencial)
MCP_SECRET=

# Puerto local (solo 127.0.0.1, no se abre al exterior)
MCP_PORT=8321

# Servicios swarm cuyos logs se pueden leer (nombres ESTABLES de servicio,
# no de task). Verlos con: docker service ls
# Ejemplo:
# ALLOWED_SERVICES=chatwoot_v410_chatwoot_app,chatwoot_v410_chatwoot_sidekiq,chatwoot_v410_chatwoot_redis,pgvector_pgvector,traefik_traefik
ALLOWED_SERVICES=

# Servicio swarm de Redis (para sidekiq_queues; la task se resuelve sola)
REDIS_SERVICE=

# Health check local: se le pega a Traefik en el host con el Host header
# del dominio de Chatwoot, sin salir a internet.
CHATWOOT_LOCAL_URL=http://127.0.0.1:80
CHATWOOT_HOST_HEADER=
