# Copiar a /opt/mcp-diag/.env y completar.
# Este archivo contiene la credencial de acceso: chmod 600, dueño mcpdiag.

# Generar con: openssl rand -hex 32   (mínimo 32 caracteres, es LA credencial)
MCP_SECRET=

# Puerto local (solo 127.0.0.1, no se abre al exterior)
MCP_PORT=8321

# Nombres reales de containers cuyos logs se pueden leer.
# Verlos con: docker ps --format '{{.Names}}'
# Ejemplo típico de Chatwoot con docker compose:
# ALLOWED_CONTAINERS=chatwoot-rails-1,chatwoot-sidekiq-1,chatwoot-postgres-1,chatwoot-redis-1
ALLOWED_CONTAINERS=

# Container de Redis (para sidekiq_queues)
REDIS_CONTAINER=

# URL local de Chatwoot (puerto que expone rails en el host)
CHATWOOT_LOCAL_URL=http://127.0.0.1:3000
