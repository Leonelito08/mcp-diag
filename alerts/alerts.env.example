# Copiar a /opt/mcp-diag/alerts/alerts.env y completar. chmod 600.

# Bot de Telegram (creado con @BotFather) y tu chat_id (curl getUpdates)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Connection string de Neon (produccion). Sacala de:
#   Railway -> servicio experienciadeviajes-agent-runtime -> Variables -> DATABASE_URL
# Debe ser la URL del pooler (ep-...-pooler...) e incluir ?sslmode=require
NEON_URL=

# Health check local de Chatwoot (via Traefik)
CHATWOOT_LOCAL_URL=http://127.0.0.1:80
CHATWOOT_HOST_HEADER=crm.experienciadeviajes.com

# Umbrales
DISK_THRESHOLD=90
HEARTBEAT_MINUTES=12
